/**
* Name: Savannah
* Coupled ABM and CA model of the African savannah: lions and zebras wander
* over a grassland grid, lions kill the zebras they run into, and grass grows.
* Specification: spec.md
* Author: Nihal Aliyeva
* Tags: ABM, CA, predation, grass growth
*/

model Savannah

/* Global: sets up the world and the starting populations */
global {
    /* Creates 20 lions and 20 zebras at random locations */
    init {
        create lion number: 20;
        create zebra number: 20;
    }
}

/* Lion: a predator that walks around randomly and kills the zebras it runs into */
species lion skills: [moving] {
    /* Moves the lion in a random direction each step */
    reflex walk {
        do wander;
    }

    /* Kills every zebra within 3 m of the lion (the lion's size) */
    reflex hunt {
        ask zebra at_distance 3.0 {
            do die;
        }
    }

    /* Draws the lion as an orange circle of radius 3 */
    aspect base {
        draw circle(3) color: #orange;
    }
}

/* Zebra: a prey that walks around randomly until a lion kills it */
species zebra skills: [moving] {
    /* Moves the zebra in a random direction each step */
    reflex walk {
        do wander;
    }

    /* Draws the zebra as a grey triangle with sides of 2 */
    aspect base {
        draw triangle(2) color: #grey;
    }
}

/* Grass: the 50 x 50 grassland cells of the CA, each holding grass biomass */
grid grass width: 50 height: 50 {
    /* Grass biomass in the cell (kg), random between 0 and 10 at the start */
    float biomass <- rnd(10.0);

    /* Colours the cell once at the start so the first frame shows the initial biomass */
    init {
        do paint;
    }

    /* Adds 0.1 kg of grass each time step (linear growth, no upper limit) */
    reflex grow {
        biomass <- biomass + 0.1;
        do paint;
    }

    /* Sets the cell colour from its biomass: pale green at 0 kg, dark green at 10 kg or more */
    action paint {
        float ratio <- min(biomass / 10.0, 1.0);
        color <- rgb(int(200 * (1 - ratio)), int(255 - 155 * ratio), int(200 * (1 - ratio)));
    }
}

/* Main experiment: shows the grassland with the animals on top */
experiment savannah type: gui {
    output {
        /* Map of the savannah: grass first, then zebras and lions drawn over it */
        display map {
            grid grass;
            species zebra aspect: base;
            species lion aspect: base;
        }
    }
}
